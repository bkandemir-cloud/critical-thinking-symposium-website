---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/toolkit/', label: 'Interview Toolkit' },
  { href: '/deep-dive/', label: 'Deep Dive Reading' },
  { href: '/subjects/', label: 'By Subject' },
  { href: '/news/', label: 'News & Events' },
  { href: '/resources/', label: 'Courses & Resources' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Critical Thinking Symposium home">
      <span class="brand-mark" aria-hidden="true">⬡</span>
      <span class="brand-text">Critical Thinking<br />Symposium</span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" aria-label="Main navigation">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 246, 242, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--charcoal);
    flex-shrink: 0;
  }
  .brand-mark {
    font-size: 1.9rem;
    color: var(--green);
    line-height: 1;
    display: block;
  }
  .brand-text {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.88rem;
    line-height: 1.2;
    color: var(--charcoal);
  }
  nav ul {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--charcoal);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.93rem;
    padding: 0.3rem 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
    white-space: nowrap;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--green);
    color: var(--green-dark);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 0.5rem;
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2.5px;
    background: var(--charcoal);
    border-radius: 2px;
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }

  @media (max-width: 1000px) {
    .menu-toggle { display: flex; }
    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 20px 40px rgba(28, 28, 46, 0.1);
    }
    nav.open { display: block; }
    nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 0.8rem 1.4rem 1.4rem;
    }
    nav li { width: 100%; }
    nav a {
      display: block;
      padding: 0.8rem 0;
      font-size: 1.05rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
