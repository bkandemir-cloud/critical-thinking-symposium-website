---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { news } from '../../data/news';

const categoryLabels: Record<string, string> = {
  event: 'Event',
  news: 'News',
  'reading-group': 'Reading Group',
};
---
<BaseLayout
  title="News & Events — Critical Thinking Symposium"
  description="Upcoming talks, conferences, reading groups, and open days for teachers and students preparing for university humanities applications."
>

  <div class="page-header section-charcoal">
    <div class="container">
      <span class="kicker">News &amp; Events</span>
      <h1>Talks, events, and reading groups</h1>
      <p class="lead">
        Upcoming opportunities to engage with the thinking that matters for university
        humanities applications — and beyond.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {news.length === 0 ? (
        <div class="empty-state">
          <p>No news or events yet. Check back soon.</p>
        </div>
      ) : (
        <ul class="news-list">
          {news.map((item) => (
            <li class="news-item">
              <div class="news-meta">
                <span class="tag">{categoryLabels[item.category] ?? item.category}</span>
                <time class="news-date" datetime={item.date}>
                  {new Date(item.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </div>
              <h2 class="news-title">{item.title}</h2>
              <p class="news-summary">{item.summary}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

</BaseLayout>

<style>
  .page-header { padding: clamp(3rem, 7vw, 5rem) 0; }
  .page-header h1 { color: #ffffff; }
  .news-list { list-style: none; padding: 0; margin: 0; }
  .news-item {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
  }
  .news-item:last-child { border-bottom: 1px solid var(--border); }
  .news-meta { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.7rem; flex-wrap: wrap; }
  .news-date { font-size: 0.88rem; color: var(--muted); }
  .news-title { font-size: clamp(1.2rem, 2.5vw, 1.6rem); margin-bottom: 0.5rem; }
  .news-summary { color: var(--muted); margin: 0; max-width: 56rem; }
  .empty-state { padding: 3rem 0; color: var(--muted); }
</style>
