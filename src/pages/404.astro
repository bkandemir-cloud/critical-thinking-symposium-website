---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found — Critical Thinking Symposium"
  description="Page not found."
>
  <section class="section">
    <div class="container not-found">
      <span class="kicker">404</span>
      <h1>Page not found</h1>
      <p class="lead">This page does not exist or has been moved.</p>
      <a class="btn btn-primary" href="/">Back to home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { padding: 4rem 0; text-align: center; max-width: 36rem; margin: 0 auto; }
  .not-found .kicker { display: block; font-size: 1rem; }
</style>
