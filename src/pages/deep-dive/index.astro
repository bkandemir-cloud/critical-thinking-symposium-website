---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readings } from '../../data/reading';
import { subjects } from '../../data/subjects';

const subjectMap = Object.fromEntries(subjects.map((s) => [s.slug, s.title]));
const difficultyLabels: Record<string, string> = {
  accessible: 'Accessible',
  moderate: 'Moderate',
  challenging: 'Challenging',
};
const typeLabels: Record<string, string> = {
  book: 'Book',
  essay: 'Essay',
  article: 'Article',
};

// Group by difficulty
const accessible = readings.filter((r) => r.difficulty === 'accessible');
const moderate = readings.filter((r) => r.difficulty === 'moderate');
const challenging = readings.filter((r) => r.difficulty === 'challenging');
---
<BaseLayout
  title="Deep Dive Reading — Critical Thinking Symposium"
  description="Curated reading lists for university humanities applicants. Annotated texts with 'why this book?' notes to build genuine critical engagement."
>

  <div class="page-header section-charcoal">
    <div class="container">
      <span class="kicker">Deep Dive Reading</span>
      <h1>Books that make you think differently</h1>
      <p class="lead">
        Not a reading list for the sake of name-dropping. These texts are chosen because they
        reward slow, attentive reading and reward it with ideas that do not go away. Each entry
        includes a &#8220;why this text?&#8221; note — the thing that makes it worth your time.
      </p>
    </div>
  </div>

  <!-- How to use -->
  <section class="section section-band">
    <div class="container how-to-grid">
      <div>
        <span class="kicker">How to use this list</span>
        <h2>Reading slowly is a skill</h2>
        <p>
          The students who stand out in Oxbridge and university interviews are rarely the ones
          who have read the most. They are the ones who have read <em>carefully</em>, who can
          say something precise and personal about a text, and who can explain why an idea
          surprised or unsettled them.
        </p>
        <p>
          The &#8220;why this text?&#8221; note beside each entry is a thinking tool, not a
          summary. It is designed to give you the angle — the reason a tutor might choose to
          discuss this text in an interview — so you can read it with that angle in mind.
        </p>
      </div>
      <div class="how-tips">
        <div class="tip">
          <span class="tip-num" aria-hidden="true">1</span>
          <div>
            <strong>Choose one text</strong>
            <p>Better to read one text properly than three texts superficially. Pick the entry with the &#8220;why&#8221; that resonates most.</p>
          </div>
        </div>
        <div class="tip">
          <span class="tip-num" aria-hidden="true">2</span>
          <div>
            <strong>Read with the Interview Toolkit</strong>
            <p>After reading, use the question generator to build a question set around the text&#8217;s central concept.</p>
          </div>
        </div>
        <div class="tip">
          <span class="tip-num" aria-hidden="true">3</span>
          <div>
            <strong>Write one page of genuine response</strong>
            <p>Not a summary. Something the text made you think, wonder, or question.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reading lists by difficulty -->
  {[
    { label: 'Accessible', items: accessible, note: 'Good starting points. Short, clear, and immediately applicable to interview preparation.' },
    { label: 'Moderate', items: moderate, note: 'Texts that reward effort. Best approached with a question already in mind.' },
    { label: 'Challenging', items: challenging, note: 'Demanding texts for students who want to go further. Even a single chapter, read carefully, is useful.' },
  ].map(({ label, items, note }) => items.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="reading-group-header">
          <span class={`difficulty-badge difficulty-${label.toLowerCase()}`}>{label}</span>
          <p class="reading-group-note">{note}</p>
        </div>
        <ul class="reading-list">
          {items.map((r) => (
            <li class="reading-item">
              <div class="reading-meta-row">
                <div class="reading-tags">
                  <span class="tag">{typeLabels[r.type] ?? r.type}</span>
                  {r.subjects.slice(0, 3).map((s) => (
                    <a class="subject-tag" href={`/subjects/${s}/`}>{subjectMap[s] ?? s}</a>
                  ))}
                </div>
                {r.year && <span class="reading-year">{r.year}</span>}
              </div>
              <h3 class="reading-title">
                <em>{r.title}</em> — {r.author}
              </h3>
              <div class="reading-why">
                <span class="why-label" aria-label="Why this text">Why this text?</span>
                <p>{r.why}</p>
              </div>
              <a class="use-in-toolkit" href={`/toolkit/?term=${encodeURIComponent(r.title)}`}>
                Use in Toolkit &rarr;
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="section section-green">
    <div class="container reading-cta">
      <div>
        <span class="kicker">Interview Toolkit</span>
        <h2>Turn any text into an interview question set</h2>
        <p class="lead">
          Enter the title, author, or key concept of any text in the toolkit and generate
          structured questions and Five Whys follow-ups.
        </p>
      </div>
      <a class="btn btn-outline-light" href="/toolkit/">Open the Toolkit</a>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header { padding: clamp(3rem, 7vw, 5rem) 0; }
  .page-header h1 { color: #ffffff; }

  .how-to-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 860px) {
    .how-to-grid { grid-template-columns: 1fr 1fr; }
  }
  .how-to-grid p { color: var(--muted); }

  .how-tips { display: flex; flex-direction: column; gap: 1.4rem; }
  .tip {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .tip-num {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
    margin-top: 0.1rem;
  }
  .tip strong { display: block; margin-bottom: 0.25rem; }
  .tip p { margin: 0; font-size: 0.9rem; color: var(--muted); }

  /* Reading groups */
  .reading-group-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .difficulty-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem;
    border-radius: 6px;
    flex-shrink: 0;
  }
  .difficulty-accessible { background: var(--green-tint); color: var(--green-dark); }
  .difficulty-moderate { background: #fef3e8; color: #8b4d1b; }
  .difficulty-challenging { background: #e8e8f4; color: var(--charcoal); }
  .reading-group-note { font-size: 0.92rem; color: var(--muted); margin: 0; }

  .reading-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .reading-item {
    border-top: 1px solid var(--border);
    padding: 1.8rem 0;
  }
  .reading-item:last-child { border-bottom: 1px solid var(--border); }

  .reading-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.7rem;
  }
  .reading-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .subject-tag {
    display: inline-block;
    background: #f0eeea;
    color: var(--charcoal-soft);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .subject-tag:hover { background: var(--border); color: var(--charcoal); }
  .reading-year { font-size: 0.88rem; color: var(--muted); white-space: nowrap; margin-top: 0.1rem; }

  .reading-title {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    margin-bottom: 0.8rem;
  }
  .reading-title em { font-style: italic; }

  .reading-why {
    background: var(--green-tint);
    border-left: 3px solid var(--green);
    padding: 0.9rem 1rem 0.9rem 1.1rem;
    border-radius: 0 8px 8px 0;
    margin-bottom: 1rem;
  }
  .why-label {
    display: inline-block;
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-dark);
    margin-bottom: 0.3rem;
  }
  .reading-why p { margin: 0; font-size: 0.93rem; color: var(--charcoal-soft); }

  .use-in-toolkit {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--green);
    text-decoration: none;
  }
  .use-in-toolkit:hover { color: var(--green-dark); }

  .reading-cta {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 700px) {
    .reading-cta { grid-template-columns: 1fr auto; }
  }
</style>
